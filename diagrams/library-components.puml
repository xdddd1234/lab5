
@startuml
title Lab 5 - Library System Component Diagram

left to right direction
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam shadowing false

actor "Бібліотекар" as Librarian

rectangle "Library System\nМежа системи" as System {

  package "Presentation Layer" {
    component "Library UI" as UI
  }

  package "API Layer" {
    component "Library API" as API
  }

  package "Business Logic Layer" {
    component "LoanService" as LoanService
    component "ReaderService" as ReaderService
    component "BookService" as BookService
    component "Clock" as Clock
  }

  package "Data Access Layer" {
    component "ReaderRepository" as ReaderRepo
    component "BookRepository" as BookRepo
    component "LoanRepository" as LoanRepo
  }

  package "Data Layer" {
    database "Library Database\nReader, Book, Author,\nCategory, Loan" as DB
  }

  interface "ILibraryAPI\nsubmitLoan()" as ILibraryAPI
  interface "ILoanService\nissueBook()" as ILoanService
  interface "IReaderService\nfindReaderById()" as IReaderService
  interface "IBookService\nfindBookById()\nisBookAvailable()" as IBookService

  interface "IReaderRepository\nfindById()" as IReaderRepository
  interface "IBookRepository\nfindById()" as IBookRepository
  interface "ILoanRepository\nfindActiveLoan()\ncreateLoan()" as ILoanRepository

  interface "IClock\ntoday()" as IClock
  interface "IDataStorage\nread()\nwrite()" as IDataStorage

  API -- ILibraryAPI
  UI ..> ILibraryAPI : requires

  LoanService -- ILoanService
  API ..> ILoanService : requires

  ReaderService -- IReaderService
  LoanService ..> IReaderService : requires

  BookService -- IBookService
  LoanService ..> IBookService : requires

  ReaderRepo -- IReaderRepository
  ReaderService ..> IReaderRepository : requires

  BookRepo -- IBookRepository
  BookService ..> IBookRepository : requires

  LoanRepo -- ILoanRepository
  LoanService ..> ILoanRepository : requires

  Clock -- IClock
  LoanService ..> IClock : requires

  DB -- IDataStorage
  ReaderRepo ..> IDataStorage : requires
  BookRepo ..> IDataStorage : requires
  LoanRepo ..> IDataStorage : requires
}

Librarian --> UI : Запит на видачу книги

note right of LoanService
  UC-03: Видача книги

  SC-01: Успішна видача
  SC-02: Книга вже видана
  SC-03: Неправильна дата
  SC-04: Читача не знайдено

  Результат:
  LoanIssued або LoanRejected
end note

note right of Clock
  Надає поточну дату
  для перевірки строку
  повернення книги.
end note

note bottom of DB
  Сутності з Lab 1:
  Reader, Book, Author,
  Category, Loan
end note

note bottom of System
  Зовнішні інтеграції Payment,
  SMS/Email та OAuth не входять
  до поточного обсягу UC-03.

  Результат видачі передається:
  LoanService -> Library API -> Library UI.
end note

@enduml
